{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(a|b|c|d|ga|merci|desinscription|replay|confirmation-consultation-strategique)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/confirmation-appel-decouverte",
      "destination": "/confirmation-consultation-strategique",
      "permanent": false
    }
  ]
}
